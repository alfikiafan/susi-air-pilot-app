# Port the API listens on
PORT=3001

# The app's "today" (YYYY-MM-DD). Fixed so the review always sees the same numbers.
TODAY=2026-05-15

# Secret used to sign access tokens. Required when NODE_ENV=production.
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=43200

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Folder holding the mock JSON files (relative to the working directory)
DATA_DIR=data
